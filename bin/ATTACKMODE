#!/bin/bash
export AM_SERIAL=no
export AM_ETHERNET=no
export AM_STORAGE=no
export AM_HID=no
FLASHDRIVE_FILE=/bunny/storage/system.img
if [ -z "$1" ]; then
    echo "Usage: ATTACKMODE [MODE1] [MODE2] ..."
    echo "Modes: SERIAL, ECM_ETHERNET, RNDIS_ETHERNET, STORAGE, HID, STOR_RNDIS, STOP"
    exit 0
fi

for AM in $@;
do
	case $AM in
		SERIAL*)
			export AM_SERIAL=yes
		;;
		ECM_ETHERNET*)
			export AM_ETHERNET=yes
		;;
		RNDIS_ETHERNET*)
			export AM_ETHERNET=yes
		;;
		STORAGE*)
			export AM_STORAGE=yes
		;;
		HID*)
			export AM_HID=yes
		;;
		FILE_IMAGE*)
			FLASHDRIVE_FILE=`echo $AM|sed -e "s/^FILE_IMAGE=//"`
		;;
		STOR_RNDIS*)
			echo "Switching to Storage + RNDIS mode..."
			/bunny/bin/storage_rndis
			echo "STOR_RNDIS configuration applied."
			exit 0
		;;
		STOP*)
			echo "Stopping all USB Gadgets..."
			for OLDDEV in `ls /sys/kernel/config/usb_gadget/`
			do
				echo "" > /sys/kernel/config/usb_gadget/$OLDDEV/UDC 2>/dev/null
				rm -rf /sys/kernel/config/usb_gadget/$OLDDEV
			done
			echo "All USB Gadgets stopped and cleaned up."
			exit 0
		;;
		*)
			echo "Unknown mode: $AM"
		;;
		esac
	done
#	echo "AM SERIAL $AM_SERIAL"
#	echo "AM ETHERNET $AM_ETHERNET"
#	echo "AM STORAGE $AM_STORAGE"
#	echo "AM HID $AM_HID"
# this file is from: https://github.com/ckuethe/usbarmory/wiki/USB-Gadgets

ID_VENDOR=0x1d6b
ID_PRODUCT=0x0104
BDC_DEVICE=0x0100
BDC_USB=0x200
SERIAL_NUMBER="fedcba9876543210"
MANUFACTURER="TimHolum"
PRODUCT="Pi Zero Bunny"


# Ensure required modules are loaded and legacy gadgets are out of the way
echo "Preparing USB Gadget modules..."
modprobe -r g_ether 2>/dev/null && echo "  - Unloaded legacy g_ether"
modprobe -r g_multi 2>/dev/null && echo "  - Unloaded legacy g_multi"
modprobe -r g_hid 2>/dev/null   && echo "  - Unloaded legacy g_hid"

if modprobe libcomposite 2>/dev/null; then
    echo "  - Module libcomposite loaded."
else
    echo "  ! Error: libcomposite failed to load."
fi

# Try common names for gadget functions
for mod in usb_f_hid f_hid usb_f_mass_storage usb_f_msc usb_f_acm usb_f_ecm usb_f_rndis; do
    if modprobe $mod 2>/dev/null; then
        echo "  - Module $mod loaded."
    fi
done

echo "Setting up gadget configuration in configfs..."

DEV_DIR=g1
DEV_INT=1
while [ -d "/sys/kernel/config/usb_gadget/$DEV_DIR" ]
do 
  DEV_INT=$((DEV_INT+1))
  DEV_DIR=g$DEV_INT
done


for OLDDEV in `ls /sys/kernel/config/usb_gadget/`
do
	echo "" > /sys/kernel/config/usb_gadget/$OLDDEV/UDC 2>/dev/null
    # Attempt to deep-clean the old gadget to avoid conflicts
    find /sys/kernel/config/usb_gadget/$OLDDEV/configs -mindepth 1 -type l -delete 2>/dev/null
    find /sys/kernel/config/usb_gadget/$OLDDEV/configs -mindepth 1 -type d -delete 2>/dev/null
    find /sys/kernel/config/usb_gadget/$OLDDEV/functions -mindepth 1 -type d -delete 2>/dev/null
    find /sys/kernel/config/usb_gadget/$OLDDEV/strings -mindepth 1 -type d -delete 2>/dev/null
    rmdir /sys/kernel/config/usb_gadget/$OLDDEV 2>/dev/null
done

# Ensure we are starting from a clean state or a new directory
DEV_DIR=g1
DEV_INT=1
while [ -d "/sys/kernel/config/usb_gadget/$DEV_DIR" ]
do 
  DEV_INT=$((DEV_INT+1))
  DEV_DIR=g$DEV_INT
done

echo "Using gadget directory: $DEV_DIR"

cd /sys/kernel/config/usb_gadget/
mkdir $DEV_DIR
cd $DEV_DIR

#Setup USB Stuff
# ... (rest of descriptors) ...

# Probing for correct HID function name
HID_FUNC=""
if [ "$AM_HID" == "yes" ]; then
    echo "Probing for HID function name..."
    for f in hid hidg; do
        if mkdir functions/$f.0 2>/dev/null; then
            HID_FUNC=$f
            echo "  - Found working HID function type: $HID_FUNC"
            # We already created it, so let's use it.
            break
        fi
    done
fi

if [ "$AM_HID" == "yes" ] && [ -n "$HID_FUNC" ]
then
    # Directory already exists from probe
    echo 1 > functions/$HID_FUNC.0/protocol
    echo 1 > functions/$HID_FUNC.0/subclass
    echo 8 > functions/$HID_FUNC.0/report_length
    echo -ne \\x05\\x01\\x09\\x06\\xa1\\x01\\x05\\x07\\x19\\xe0\\x29\\xe7\\x15\\x00\\x25\\x01\\x75\\x01\\x95\\x08\\x81\\x02\\x95\\x01\\x75\\x08\\x81\\x03\\x95\\x05\\x75\\x01\\x05\\x08\\x19\\x01\\x29\\x05\\x91\\x02\\x95\\x01\\x75\\x03\\x91\\x03\\x95\\x06\\x75\\x08\\x15\\x00\\x25\\x65\\x05\\x07\\x19\\x00\\x29\\x65\\x81\\x00\\xc0 > functions/$HID_FUNC.0/report_desc
    ln -s functions/$HID_FUNC.0 configs/c.$C/
elif [ "$AM_HID" == "yes" ]; then
    echo "  ! Error: Could not create HID function. Module may be loaded but type not registered."
    echo "    Try: dmesg | grep usb"
fi


echo 250 > configs/c.$C/MaxPower 
if [ "$AM_SERIAL" == "yes" ]
then
	ln -s functions/acm.$N configs/c.$C/
fi

# this lists available UDC drivers
ls /sys/class/udc > UDC 2>/dev/null

if [ "$AM_ETHERNET" == "yes" ]
then
    if ip link show $N >/dev/null 2>&1; then
        ip addr add 172.16.64.1/24 dev $N 2>/dev/null || true
        ip link set $N up
        systemctl restart isc-dhcp-server.service || true
    else
        echo "usb0 not present yet; skipping DHCP start."
    fi
fi

echo "ATTACKMODE configuration applied:"
echo "  SERIAL:   $AM_SERIAL"
echo "  ETHERNET: $AM_ETHERNET"
echo "  STORAGE:  $AM_STORAGE"
echo "  HID:      $AM_HID"
echo "  IMAGE:    $FLASHDRIVE_FILE"


 
